{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/index.mjs": {"includeFiles": "server/**", "maxDuration": 30, "regions": ["gru1"]}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api"}, {"source": "/((?!api|assets|fonts).*)", "destination": "/index.html"}],
  "headers": [{"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
